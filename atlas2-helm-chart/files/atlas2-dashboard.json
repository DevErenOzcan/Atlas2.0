{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__elements": {},
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.6.1" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "piechart", "name": "Pie chart", "version": "" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "datasource", "uid": "grafana" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "target": { "limit": 100, "matchAny": false, "tags": [], "type": "dashboard" },
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "title": "Atlas2 - Microservices Monitoring Dashboard",
  "tags": ["atlas2", "prometheus", "grpc", "go"],
  "style": "dark",
  "timezone": "",
  "panels": [
    { "type": "row", "title": "Overview", "id": 1, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "datasource": { "type": "prometheus", "uid": "prometheus" } },

    { "type": "stat", "title": "User Service Up", "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": {"text": "DOWN"}, "1": {"text": "UP"} } } ],
        "thresholds": { "steps": [ {"color": "red"}, {"color": "green", "value": 1} ] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto" },
      "targets": [ { "refId": "A", "expr": "up{job=\"user\"}" } ] },

    { "type": "stat", "title": "Product Service Up", "id": 3,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": {"text": "DOWN"}, "1": {"text": "UP"} } } ],
        "thresholds": { "steps": [ {"color": "red"}, {"color": "green", "value": 1} ] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "expr": "up{job=\"product\"}" } ] },

    { "type": "stat", "title": "Order Service Up", "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": {"text": "DOWN"}, "1": {"text": "UP"} } } ],
        "thresholds": { "steps": [ {"color": "red"}, {"color": "green", "value": 1} ] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "expr": "up{job=\"order\"}" } ] },

    { "type": "stat", "title": "Gateway Up", "id": 5,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": {"text": "DOWN"}, "1": {"text": "UP"} } } ],
        "thresholds": { "steps": [ {"color": "red"}, {"color": "green", "value": 1} ] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "expr": "up{job=\"gateway\"}" } ] },

    { "type": "row", "title": "gRPC Traffic", "id": 6, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }, "datasource": { "type": "prometheus", "uid": "prometheus" } },

    { "type": "timeseries", "title": "gRPC Requests per Second (by service)", "id": 7,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "expr": "sum by (job) (rate(grpc_server_started_total{job=~\"user|product|order\"}[$__rate_interval]))", "legendFormat": "{{job}}" } ] },

    { "type": "timeseries", "title": "gRPC 95th Percentile Latency (ms) by service", "id": 8,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "ms" } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, job) (rate(grpc_server_handling_seconds_bucket{job=~\"user|product|order\"}[$__rate_interval]))) * 1000", "legendFormat": "{{job}}" } ] },

    { "type": "timeseries", "title": "gRPC Error Rate by Code", "id": 9,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "expr": "sum by (job, grpc_code) (rate(grpc_server_handled_total{job=~\"user|product|order\", grpc_code!=\"OK\"}[$__rate_interval]))", "legendFormat": "{{job}} {{grpc_code}}" } ] },

    { "type": "table", "title": "Top 10 gRPC methods by RPS", "id": 10,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "options": { "showHeader": true },
      "targets": [ { "refId": "A", "expr": "topk(10, sum by (job, grpc_service, grpc_method) (rate(grpc_server_started_total{job=~\"user|product|order\"}[$__rate_interval])))", "instant": true } ] },

    { "type": "row", "title": "Go Runtime", "id": 11, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }, "datasource": { "type": "prometheus", "uid": "prometheus" } },

    { "type": "timeseries", "title": "Goroutines by service", "id": 12,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "expr": "go_goroutines{job=~\"user|product|order|gateway\"}", "legendFormat": "{{job}}" } ] },

    { "type": "timeseries", "title": "Memory Alloc (bytes) by service", "id": 13,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "bytes" } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "expr": "go_memstats_alloc_bytes{job=~\"user|product|order|gateway\"}", "legendFormat": "{{job}}" } ] },

    { "type": "row", "title": "System", "id": 14, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 }, "datasource": { "type": "prometheus", "uid": "prometheus" } },

    { "type": "timeseries", "title": "CPU Usage %", "id": 15,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "percent", "min": 0, "max": 100 } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "expr": "100 - (avg(irate(node_cpu_seconds_total{job=\"node-exporter\", mode=\"idle\"}[$__rate_interval])) * 100)" } ] },

    { "type": "timeseries", "title": "Memory Usage %", "id": 16,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "percent", "min": 0, "max": 100 } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "expr": "(1 - (node_memory_MemAvailable_bytes{job=\"node-exporter\"} / node_memory_MemTotal_bytes{job=\"node-exporter\"})) * 100" } ] },

    { "type": "timeseries", "title": "Disk Usage %", "id": 17,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "percent", "min": 0, "max": 100 } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "expr": "100 - ((sum by (instance, mountpoint) (node_filesystem_avail_bytes{job=\"node-exporter\", fstype!~\"tmpfs|overlay|squashfs\"}) * 100) / sum by (instance, mountpoint) (node_filesystem_size_bytes{job=\"node-exporter\", fstype!~\"tmpfs|overlay|squashfs\"}))", "legendFormat": "{{instance}} {{mountpoint}}" } ] },

    { "type": "timeseries", "title": "Network Traffic (bps)", "id": 18,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "bps" } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "rate(node_network_receive_bytes_total{job=\"node-exporter\", device!=\"lo\"}[$__rate_interval]) * 8", "legendFormat": "{{device}} - Receive" },
        { "refId": "B", "expr": "rate(node_network_transmit_bytes_total{job=\"node-exporter\", device!=\"lo\"}[$__rate_interval]) * 8 * -1", "legendFormat": "{{device}} - Transmit" }
      ] },

    { "type": "row", "title": "Database (Postgres)", "id": 19, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 50 }, "datasource": { "type": "prometheus", "uid": "prometheus" } },

    { "type": "stat", "title": "User DB Up", "id": 20,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 51 },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": {"text": "DOWN"}, "1": {"text": "UP"} } } ],
        "thresholds": { "steps": [ {"color": "red"}, {"color": "green", "value": 1} ] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "expr": "up{job=\"postgres-user\"}" } ] },

    { "type": "stat", "title": "Product DB Up", "id": 21,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 51 },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": {"text": "DOWN"}, "1": {"text": "UP"} } } ],
        "thresholds": { "steps": [ {"color": "red"}, {"color": "green", "value": 1} ] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "expr": "up{job=\"postgres-product\"}" } ] },

    { "type": "stat", "title": "Order DB Up", "id": 22,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 51 },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": {"text": "DOWN"}, "1": {"text": "UP"} } } ],
        "thresholds": { "steps": [ {"color": "red"}, {"color": "green", "value": 1} ] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "expr": "up{job=\"postgres-order\"}" } ] },

    { "type": "timeseries", "title": "Active Connections (by DB)", "id": 23,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 57 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "expr": "sum by (job) (pg_stat_database_numbackends{job=~\"postgres-user|postgres-product|postgres-order\", datname!~\"template.*\"})", "legendFormat": "{{job}}" } ] },

    { "type": "timeseries", "title": "TPS (Commits+Rollbacks)", "id": 24,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 57 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops" } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "expr": "sum by (job) (rate(pg_stat_database_xact_commit{job=~\"postgres-user|postgres-product|postgres-order\", datname!~\"template.*\"}[$__rate_interval]) + rate(pg_stat_database_xact_rollback{job=~\"postgres-user|postgres-product|postgres-order\", datname!~\"template.*\"}[$__rate_interval]))", "legendFormat": "{{job}}" } ] },

    { "type": "timeseries", "title": "Cache Hit Ratio %", "id": 25,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 65 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "percent" } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "expr": "(sum by (job) (rate(pg_stat_database_blks_hit{job=~\"postgres-user|postgres-product|postgres-order\", datname!~\"template.*\"}[$__rate_interval])) / sum by (job) (rate((pg_stat_database_blks_hit{job=~\"postgres-user|postgres-product|postgres-order\", datname!~\"template.*\"} + pg_stat_database_blks_read{job=~\"postgres-user|postgres-product|postgres-order\", datname!~\"template.*\"})[$__rate_interval]))) * 100", "legendFormat": "{{job}}" } ] },

    { "type": "timeseries", "title": "Block Read Rate (blks/s)", "id": 26,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 65 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops" } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "expr": "sum by (job) (rate(pg_stat_database_blks_read{job=~\"postgres-user|postgres-product|postgres-order\", datname!~\"template.*\"}[$__rate_interval]))", "legendFormat": "{{job}}" } ] },

    { "type": "timeseries", "title": "Tuples Ops/sec", "id": 27,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 73 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (job) (rate(pg_stat_database_tup_inserted{job=~\"postgres-user|postgres-product|postgres-order\", datname!~\"template.*\"}[$__rate_interval]))", "legendFormat": "inserted {{job}}" },
        { "refId": "B", "expr": "sum by (job) (rate(pg_stat_database_tup_updated{job=~\"postgres-user|postgres-product|postgres-order\", datname!~\"template.*\"}[$__rate_interval]))", "legendFormat": "updated {{job}}" },
        { "refId": "C", "expr": "sum by (job) (rate(pg_stat_database_tup_deleted{job=~\"postgres-user|postgres-product|postgres-order\", datname!~\"template.*\"}[$__rate_interval]))", "legendFormat": "deleted {{job}}" }
      ] }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "version": 0
}
